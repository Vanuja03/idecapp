{
  "expo": {
    "name": "IDEC",
    "slug": "IDEC",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/idec-logo-transparent.png",
    "scheme": "idec",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.idec.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/idec-logo-transparent.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/idec-logo.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/idec-logo.jpg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3F8FD",
          "dark": {
            "backgroundColor": "#0A2A4D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "456b9545-cdff-4bce-aa6d-2491f353237c"
      }
    }
  }
}
